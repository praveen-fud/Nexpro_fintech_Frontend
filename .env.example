# ── Local development ────────────────────────────────────────────────────────
# Copy to .env for local dev.  Railway: set as Environment Variables instead.

# Set to "false" to use the real backend (required for production).
# Set to "true" ONLY if you want to run the app without any backend server
# (full in-memory simulation — useful for UI-only previews).
VITE_DEMO_MODE=false

# Backend URL for production builds (Railway frontend → Railway backend).
# Leave blank in local dev — the Vite proxy handles it automatically.
# Example: VITE_API_URL=https://nexpro-api.up.railway.app
VITE_API_URL=

# ── SEO / canonical origin ──────────────────────────────────────────────────
# The production origin, with no trailing slash. Used to build canonical
# links, Open Graph URLs, sitemap.xml, robots.txt and llms.txt at BUILD time,
# so it must be set as a build environment variable on the host (Netlify:
# Site settings → Environment variables), not just locally.
#
# Get this wrong and every canonical tag points at the wrong domain, which is
# worse than having none. Leave it unset in local dev — it falls back to the
# dev server origin.
VITE_SITE_URL=https://nexpropaytech.com
