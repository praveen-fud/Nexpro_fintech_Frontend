# ── Local development ────────────────────────────────────────────────────────
# Copy to .env for local dev.  Railway: set as Environment Variables instead.

# Set to "false" to use the real backend (required for production).
# Set to "true" ONLY if you want to run the app without any backend server
# (full in-memory simulation — useful for UI-only previews).
VITE_DEMO_MODE=false

# Backend URL for production builds (Railway frontend → Railway backend).
# Leave blank in local dev — the Vite proxy handles it automatically.
# Example: VITE_API_URL=https://nexpro-api.up.railway.app
VITE_API_URL=
